{
  "name": "lantern-tide",
  "private": true,
  "version": "0.4.2",
  "description": "Ladice: Lantern Tide — a cosy night-sea ramming arcade game. Spiritual successor to Ladice.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "balance": "vitest run tests/sim/balance.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.1.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
